<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.3.0.0</Version>
    <Author>c0nkcr33t</Author>
    <Name>Chocobo Radio</Name>
    <Punchline>Your mount's internet radio.</Punchline>
    <Description>Open a radio panel on mounting and listen to saved internet stations inside the plugin, following game music settings.</Description>
    <RepoUrl>https://github.com/c0nkcr33t/chocobo-radio</RepoUrl>
    <Tags>radio;audio;mount</Tags>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/fonts/*.ttf" LogicalName="ChocoboRadio.Fonts.%(Filename)%(Extension)" />
    <None Include="licenses/*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <Reference Update="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath></Reference>
    <Reference Update="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath></Reference>
    <Reference Update="Dalamud.Bindings.ImPlot"><HintPath>$(DalamudLibPath)Dalamud.Bindings.ImPlot.dll</HintPath></Reference>
    <Reference Update="Dalamud.Bindings.ImGuizmo"><HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGuizmo.dll</HintPath></Reference>
  </ItemGroup>
</Project>
